# SPDX-License-Identifier: Apache-2.0
#
# Image for banlieue-imagebuilder's pre-lay Job (ADR-0113, Amendment
# 2026-11-01): `--prelay-image`.
#
# The Job boots a freshly built Kairos raw image once, under QEMU/KVM with no
# network and no TPM, through the recovery reset every clone would otherwise
# run on its first boot, and writes the result beside it on the artifacts PVC
# (scripts/prelay-kairos-raw.sh says exactly what it does and refuses). It
# needs QEMU and OVMF to boot the image, and loop devices, mounts and
# e2fsprogs, gdisk and util-linux to inspect and fix the disk afterwards.
#
# Unlike the banlieue image (distroless, one static binary) this one is a
# Debian userland, because the job is a shell script over those tools. It
# runs privileged in the build namespace (ADR-0016) with no API access.
#
# Published by CI as ghcr.io/firestoned/banlieue-prelay (linux/amd64,
# Cosign-signed; .github/workflows/build.yaml, job docker-prelay), the
# imagebuilder's --prelay-image default (ADR-0113, amendment 2026-11-04), and
# scanned by its own Grype gate (`make grype-prelay`, VEX in .vex/prelay/).
# Build it yourself with:
#     docker build -f Dockerfile.prelay -t <registry>/banlieue-prelay:<tag> .
#
# Pinned by digest, on a literal FROM line, so Dependabot re-pins it (see
# Dockerfile for why the digest must not hide behind an ARG). BASE_IMAGE stays
# overridable for a mirror.
ARG BASE_IMAGE=pinned-base

FROM docker.io/library/debian:13-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS pinned-base

FROM ${BASE_IMAGE}

# qemu-system-x86: the build boot; ovmf: its UEFI firmware; e2fsprogs:
# mke2fs; gdisk: sgdisk -e; util-linux: losetup, blkid, mount; coreutils:
# sha256sum/sha512sum, truncate, cp --sparse.
#
# `apt-get upgrade` first: the pinned base only moves when Debian rebuilds
# debian:13-slim, which can lag a security fix by weeks, and the Grype gate
# fails on a fixed high finding (zlib1g, CVE-2026-76844 and CVE-2026-85091,
# fixed in 1:1.3.dfsg+really1.3.1-1+deb13u1, absent from the 2026-11-04
# base). The package installs below already take the archive's current
# versions, so the image was never more reproducible than that.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-install-recommends \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      qemu-system-x86 ovmf e2fsprogs gdisk util-linux coreutils \
 && rm -rf /var/lib/apt/lists/*

COPY scripts/prelay-kairos-raw.sh /usr/local/bin/prelay-kairos-raw.sh
RUN chmod 0755 /usr/local/bin/prelay-kairos-raw.sh

ENTRYPOINT ["/usr/local/bin/prelay-kairos-raw.sh"]
