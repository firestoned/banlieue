# Generated by Cargo
# will have compiled files and executables
debug
target

# Cross-compiled binary output
binaries/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Documentation build artefacts (MkDocs)
docs/site/
docs/.venv/
docs/__pycache__/

.DS_Store

# OpenWolf working directory. Most of it is local session state; three files
# are checked in because they are knowledge other contributors need.
#
# NOTE the shape: a bare `.wolf` would exclude the DIRECTORY, and git never
# descends into an excluded directory — so `!.wolf/cerebrum.md` would be
# silently ineffective. Exclude the contents, then re-include by name.
.wolf/*
!.wolf/README.md
!.wolf/OPENWOLF.md
!.wolf/cerebrum.md
!.wolf/buglog.json
!.wolf/anatomy.md

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Per-cluster kubeconfig written by `make kind-e2e` (ADR-0014). Scoped to the
# kind cluster so the suite never depends on — or mutates — your current context.
.kind-kubeconfig-*
