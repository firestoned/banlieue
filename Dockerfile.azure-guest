# SPDX-License-Identifier: Apache-2.0
#
# The Azure guest helper as a kairos-operator bundle (ADR-0171).
#
# banlieue-imagebuilder lists this image in the OSArtifact's
# spec.artifacts.bundles for every VMImage with an azure source; kairos-operator
# unpacks it onto the build root filesystem (`auroraboot unpack <image>
# /rootfs`) after the source image, so the binary lands in the recovery image
# and in every image installed from it. It is never run as a container.
#
# One file and nothing else, so unpacking it cannot change anything in the
# source image but this path. /usr/bin, not /usr/local/bin: on Kairos,
# /usr/local is the persistent partition and would hide it.
#
# Expects the static musl binary at binaries/<TARGETARCH>/banlieue-azure-guest
# (`make azure-guest-binary`); we never compile inside the container. The
# imagebuilder takes the published image by digest only
# (--azure-guest-image <repository>@sha256:<digest>).
#
#     make azure-guest-image
FROM scratch

ARG TARGETARCH
ARG VERSION
ARG GIT_SHA

LABEL org.opencontainers.image.source="https://github.com/firestoned/banlieue" \
      org.opencontainers.image.description="banlieue Azure guest helper, a kairos-operator bundle (ADR-0171)" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}"

COPY --chmod=0755 binaries/${TARGETARCH}/banlieue-azure-guest /usr/bin/banlieue-azure-guest
