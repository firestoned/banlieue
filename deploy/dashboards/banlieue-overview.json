{
  "annotations": {
    "list": []
  },
  "description": "banlieue controllers and providers: reconcile rate, errors, latency, leadership, VirtualMachines by phase and Provider failure domains (ADR-0091). Built only on banlieue_* metrics.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Reconciles",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Reconcile rate by controller and result",
      "description": "banlieue_reconcile_total. result is success (steady state), requeue (asked to run again soon) or error.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (controller, result) (rate(banlieue_reconcile_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{controller}} {{result}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reconcile error ratio by controller",
      "description": "Share of reconciles that returned an error.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (controller) (rate(banlieue_reconcile_total{job=~\"$job\", result=\"error\"}[$__rate_interval])) / sum by (controller) (rate(banlieue_reconcile_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{controller}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Reconcile duration p95 by controller",
      "description": "95th percentile of banlieue_reconcile_duration_seconds.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (controller, le) (rate(banlieue_reconcile_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{controller}} p95"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.5, sum by (controller, le) (rate(banlieue_reconcile_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{controller}} p50"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reconcile errors by controller and kind",
      "description": "banlieue_reconcile_errors_total. kind is the typed error's variant name (Kube, Missing, Vsphere, Libvirt, ...).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (controller, kind) (rate(banlieue_reconcile_errors_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{controller}} {{kind}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Leadership and inventory",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "panels": []
    },
    {
      "id": 7,
      "type": "table",
      "title": "Leader per replica",
      "description": "banlieue_leader: 1 on the replica holding its role's lease (or running without election), 0 on a standby (ADR-0093).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (role, pod) (banlieue_leader{job=~\"$job\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "leader" } } }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "VirtualMachines by phase",
      "description": "banlieue_virtualmachines, from the controller's cache.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (phase) (banlieue_virtualmachines{job=~\"$job\"})",
          "legendFormat": "{{phase}}",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Failure domains per Provider",
      "description": "banlieue_provider_failure_domains, from each Provider's status. kind is the ProviderClass.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (provider, kind) (banlieue_provider_failure_domains{job=~\"$job\"})",
          "legendFormat": "{{provider}} ({{kind}})",
          "instant": true
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["banlieue", "kubernetes"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(banlieue_leader, job)", "refId": "job" },
        "definition": "label_values(banlieue_leader, job)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "hide": 0,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "banlieue overview",
  "uid": "banlieue-overview",
  "version": 1
}
