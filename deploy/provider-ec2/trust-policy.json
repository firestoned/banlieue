{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustOneServiceAccountOfOneCluster",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::ACCOUNT_ID:oidc-provider/ISSUER_HOST_PATH"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "ISSUER_HOST_PATH:sub": "system:serviceaccount:SERVICEACCOUNT_NAMESPACE:SERVICEACCOUNT_NAME",
          "ISSUER_HOST_PATH:aud": "sts.amazonaws.com"
        }
      }
    }
  ]
}
