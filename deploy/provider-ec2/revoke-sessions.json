{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RevokeEverySessionIssuedBeforeTheIncident",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "DateLessThan": {
          "aws:TokenIssueTime": "REVOKE_BEFORE"
        }
      }
    }
  ]
}
